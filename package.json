{
  "name": "year-end-random-matching",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=scripts/seed-local.sql",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev:worker": "wrangler dev",
    "dev": "npm run build && npm run db:migrate:local && wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy:dry": "npm run build && wrangler deploy --env production --dry-run",
    "deploy:prod": "npm run build && wrangler deploy --env production",
    "db:reset:local": "node scripts/reset-local-db.mjs && npm run db:migrate:local"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
