{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 최상위 설정 = 로컬 개발(wrangler dev). 운영은 아래 env.production 을 사용한다.
  "name": "gift-exchange-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 는 정적 파일보다 먼저 Worker 가 처리한다.
    "run_worker_first": ["/api/*"],
  },
  "triggers": {
    // 전원 확정 후 완료되지 못한 자동 매칭을 매분 재시도한다.
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      // 로컬 개발 전용 DB. wrangler dev 는 .wrangler/state 의 로컬 SQLite 를 사용하며
      // 이 ID 로 원격 DB 에 접속하지 않는다.
      "binding": "DB",
      "database_name": "gift-exchange-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
    {
      "binding": "gift_exchange_prod",
      "database_name": "gift-exchange-prod",
      "database_id": "9a8583f8-686d-4e67-8bbf-e44e95b4712b",
      "remote": true,
    },
  ],
  "env": {
    "production": {
      "name": "gift-exchange",
      "triggers": {
        "crons": ["* * * * *"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gift-exchange-prod",
          // `wrangler d1 create gift-exchange-prod` 결과의 database_id 로 교체한다.
          "database_id": "9a8583f8-686d-4e67-8bbf-e44e95b4712b",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
